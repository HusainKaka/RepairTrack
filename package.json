{
  "name": "repairtrack",
  "version": "1.0.0",
  "private": true,
  "description": "Secure multi-tenant repair management platform with web and Android clients",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "pnpm --filter @repairtrack/backend build && pnpm --filter @repairtrack/web build",
    "dev": "pnpm --parallel --filter @repairtrack/backend --filter @repairtrack/web dev",
    "lint": "pnpm --filter @repairtrack/backend lint && pnpm --filter @repairtrack/web lint",
    "test": "pnpm --filter @repairtrack/backend test && pnpm --filter @repairtrack/web test",
    "typecheck": "pnpm --filter @repairtrack/backend typecheck && pnpm --filter @repairtrack/web typecheck",
    "format:check": "prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.6.2"
  },
  "pnpm": {
    "overrides": {
      "qs": "^6.16.0",
      "proxy-addr": "^2.0.8",
      "js-yaml": "^4.3.2",
      "source-map-js": "^1.2.2",
      "deepmerge-ts": "^8.0.0",
      "ip-address": "^10.7.1",
      "brace-expansion@<2": "^1.1.21",
      "brace-expansion@>=2 <3": "^2.1.7",
      "brace-expansion@>=4": "^5.0.12"
    }
  }
}
